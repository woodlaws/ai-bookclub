# Vercel 프로젝트 환경 변수에 등록하세요. 실제 키는 Git에 커밋하지 않습니다.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# 가입 신청 서버 전용 설정 (NEXT_PUBLIC_ 접두사를 사용하지 마세요.)
GOOGLE_APPS_SCRIPT_WEB_APP_URL=
GOOGLE_APPS_SCRIPT_SHARED_SECRET=

# 신청 화면에 공개할 확인된 개인정보 운영 정보입니다. 둘 다 없으면 접수가 비활성화됩니다.
JOIN_PRIVACY_OPERATOR_NAME=
JOIN_PRIVACY_RETENTION_PERIOD=
